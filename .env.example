# ============================================================================
# Book Shop + Reader MVP — 环境变量占位符
# 复制为 .env.local 后填写。完整说明见 docs/env.md。
# ⚠️ 敏感变量（SUPABASE_SERVICE_ROLE_KEY / STRIPE_* / RESEND_API_KEY）
#    参考 docs/env.md。切勿以 NEXT_PUBLIC_ 前缀提交密钥。
# ============================================================================

# --- Supabase ---
# 练习项目 pxksjlandbfeyvxvasms（真实密钥只写 .env.local）
NEXT_PUBLIC_SUPABASE_URL=https://pxksjlandbfeyvxvasms.supabase.co
# anon key (public, RLS enforced)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# service-role key (SERVER ONLY, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Resend ---
RESEND_API_KEY=re_...
RESEND_FROM=BookShop <onboarding@resend.dev>

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CURRENCY=usd

# --- Admin (email 白名单, 逗号分隔) ---
ADMIN_EMAILS=admin@example.com
